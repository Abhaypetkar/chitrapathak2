# ============================================
# Chitrapathak-2 OCR API - Environment Config
# ============================================

# HuggingFace model identifier
MODEL_NAME=krutrim-ai-labs/Chitrapathak-2

# Maximum tokens to generate per OCR request
MAX_NEW_TOKENS=2048

# Default language hint
DEFAULT_LANGUAGE=sanskrit

# Number of concurrent OCR workers
MAX_WORKERS=2

# Directory paths (relative to project root)
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
LOG_DIR=logs

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Server configuration
HOST=0.0.0.0
PORT=8000

# HuggingFace token (optional, required for gated models)
# HF_TOKEN=hf_your_token_here
